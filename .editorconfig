root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.cs]
indent_size = 4

# Private methods use an underscore prefix in this codebase (e.g. _ProcessMessageAsync)
# to visually distinguish them from public/protected members — silence IDE1006 for it.
dotnet_naming_rule.private_methods_underscore.symbols = private_methods
dotnet_naming_rule.private_methods_underscore.style = underscore_prefix_pascal_case
dotnet_naming_rule.private_methods_underscore.severity = silent

dotnet_naming_symbols.private_methods.applicable_kinds = method
dotnet_naming_symbols.private_methods.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix_pascal_case.required_prefix = _
dotnet_naming_style.underscore_prefix_pascal_case.capitalization = pascal_case

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{csproj,sln,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
